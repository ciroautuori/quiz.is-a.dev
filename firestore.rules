rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Leaderboard: lettura pubblica, scrittura solo autenticati
    match /leaderboard/{recordId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(recordId) 
        && request.resource.data.keys().hasAll(['id', 'nomeUtente', 'punteggio', 'data'])
        && request.resource.data.nomeUtente is string
        && request.resource.data.nomeUtente.size() > 0
        && request.resource.data.nomeUtente.size() <= 50
        && request.resource.data.punteggio is number
        && request.resource.data.punteggio >= 0
        && request.resource.data.punteggio <= 100000;
      allow update, delete: if false;
    }

    // PvP Duels Matchmaking: lettura e scrittura solo autenticati
    match /duels/{duelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(duelId)
        && request.resource.data.p1Hp == 100
        && request.resource.data.p2Hp == 100
        && request.resource.data.status == 'waiting';
      allow update: if isSignedIn()
        && isValidId(duelId)
        && request.resource.data.p1Hp is number
        && request.resource.data.p1Hp >= 0
        && request.resource.data.p1Hp <= 100
        && request.resource.data.p2Hp is number
        && request.resource.data.p2Hp >= 0
        && request.resource.data.p2Hp <= 100;
      allow delete: if false;
    }

    // Custom Questions: lettura pubblica (contenuti educativi condivisi),
    // scrittura solo autenticati e owner
    match /custom_questions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(questionId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.domanda is string
        && request.resource.data.domanda.size() <= 1000
        && request.resource.data.opzioni is list
        && request.resource.data.opzioni.size() == 4;
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // User progress: solo l'owner puo' leggere e scrivere
    match /users/{userId}/progress/main {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
  }
}
